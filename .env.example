# CraftLayers environment.
#
# RULE: anything prefixed VITE_ is inlined into the public JavaScript bundle by
# Vite at build time. Never put a credential behind a VITE_ prefix. Every value
# below is read only inside Vercel Functions (api/), so none of it reaches the
# browser.
#
# Copy to .env for local development. .env is gitignored. Never commit real values.

# --- Model access (server-only) -------------------------------------------
# Used by api/intervention.ts. Spendable — treat as a live credential.
OPENAI_API_KEY=

# --- Chat gateway (server-only) -------------------------------------------
# Used by api/chat.ts. The URL is not itself sensitive; the auth value is.
B_GATEWAY_URL=
B_GATEWAY_AUTH=

# --- Private dashboard auth (server-only) ---------------------------------
# ACCESS_DASHBOARD_PASSWORD is what you type on the sign-in screen.
# ACCESS_DASHBOARD_SECRET signs the session cookie — use a long random value,
# e.g. `openssl rand -base64 48`. Rotating it invalidates every live session.
ACCESS_DASHBOARD_PASSWORD=
ACCESS_DASHBOARD_SECRET=

# --- Crawler tracker storage (server-only) --------------------------------
# Written by middleware.ts, read by api/crawler-stats.ts. Vercel sets this
# automatically once a Blob store is connected to the project. Without it,
# crawler capture is a silent no-op and the tracker reports "not provisioned"
# rather than pretending no crawler has visited.
BLOB_READ_WRITE_TOKEN=
